# Template: install.sh copies it to ~/.aws/credentials once.
# Put real keys only in ~/.aws/credentials, never in this file.
# If the account offers IAM Identity Center, prefer `aws configure sso`:
# it uses temporary credentials and nothing long-lived is stored here.
[default]
aws_access_key_id = YOUR_ACCESS_KEY_ID
aws_secret_access_key = YOUR_SECRET_ACCESS_KEY
